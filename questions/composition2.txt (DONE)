    MOTORCYCLE = "motorcycle"
    CAR = "car"
    TRUCK = "truck"

class ParkingSpot:
    def __init__(self, spot_id, vehicle_type):
        self.spot_id = spot_id
        self.vehicle_type = vehicle_type
        self.occupied = False

class ParkingFloor:
    def __init__(self, number, spot_counts):
        pass

    def find_available_spot(self, vehicle_type):
        pass

    def occupancy(self):
        pass
```

Example Usage:

```
floor = ParkingFloor(1, {VehicleType.CAR: 2, VehicleType.TRUCK: 1})
spot = floor.find_available_spot(VehicleType.CAR)
print(spot.spot_id)
spot.occupied = True
print(floor.find_available_spot(VehicleType.CAR).spot_id)
print(floor.occupancy())
```

Example Output:

```
